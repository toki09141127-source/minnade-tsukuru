# Copy to .env.staging.local. Never copy production .env.local.
STAGING_TEST=true
STAGING_ENVIRONMENT=staging
STAGING_SYNTHETIC_ONLY=true
STAGING_EXPECTED_PROJECT_REF=REPLACE_WITH_NEW_PROJECT_REF
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_NEW_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_ONLY_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_STAGING_ONLY_SECRET
# Optional direct DB connection for metadata checks. Store password only locally.
STAGING_DATABASE_URL=
# Existing isolated test runtime containing pg; not a database connection.
MVP_TEST_RUNTIME=
